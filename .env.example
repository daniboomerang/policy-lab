# Policy Lab makes no Saifuro calls and needs no Saifuro key. Never add one here.

# Vinaya log read token — server only, authenticates the development record's read of this
# repo's Vinaya log for /dev-stats. Put the real value in .env.local (gitignored).
# Never prefix with NEXT_PUBLIC_.
VINAYA_LOG_READ_TOKEN=

# GitHub token — server only, optional. Raises the development record's GitHub read from the
# anonymous 60 requests/hour limit. Read-only (GET) scope; never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
